import { Button, VerticalBox, LineEdit, GroupBox, HorizontalBox, ComboBox, CheckBox, ScrollView, StandardListView, TextEdit } from "std-widgets.slint";

// --- THEME CONFIGURATION ---
global Palette {
    out property <color> background: #121212;
    out property <color> surface: #1e1e1e;
    out property <color> border: #333333;
    out property <color> primary: #3daee9;
    out property <color> text: #e0e0e0;
    out property <color> text-muted: #888888;
    out property <color> success: #2ecc71;
    out property <color> error: #e74c3c;
}

// --- REUSABLE COMPONENT: INPUT FIELD WITH LABEL ---
component LabelledInput inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: text;
    
    spacing: 4px;

    Text {
        text: root.label;
        color: Palette.text-muted;
        font-size: 11px;
    }
    input := LineEdit {
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        height: 32px;
    }
}

// --- REUSABLE COMPONENT: STYLED CHECKBOX ---
component StyledCheckBox inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    
    height: 32px;
    
    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-width: 1px;
                border-color: root.checked ? Palette.primary : Palette.border;
                border-radius: 4px;
                background: root.checked ? Palette.primary : transparent;

                if (root.checked) : Path {
                    width: 10px;
                    height: 8px;
                    x: 4px;
                    y: 5px;
                    stroke: Palette.background;
                    stroke-width: 2px;
                    commands: "M 0 4 L 3 7 L 10 0";
                }
            }
        }

        Text {
            text: root.text;
            color: Palette.text;
            font-size: 13px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.checked = !root.checked; }
    }
}

// --- REUSABLE COMPONENT: CARD CONTAINER ---
component Card inherits Rectangle {
    in property <string> title;
    
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 15px;
        spacing: 12px;

        if (root.title != "") : Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Palette.primary;
        }
        @children
    }
}

// --- MAIN APPLICATION ---
export component AppWindow inherits Window {
    title: "rSMPP Client";
    icon: @image-url("../icon.png");
    min-width: 450px; 
    min-height: 700px;
    background: Palette.background;

    // --- CALLBACKS ---
    callback connect(string, string, string, string, string, bool); // ip, port, system_id, password, bind_mode, use_ssl
    callback unbind(); 
    callback send_message(
        string, string, string, // source
        string, string, string, // dest
        string, string, string, string, string, string, bool // payload details
    );
    callback query_sm(string, string, string, string); // msg_id, source, source_ton, source_npi
    callback cancel_sm(string, string, string, string, string, string, string); // msg_id, source, src_ton, src_npi, dest, dest_ton, dest_npi
    callback replace_sm(string, string, string, string, string); // msg_id, source, source_ton, source_npi, new_message 
    pure callback string_length(string) -> int; 

    // --- PROPERTIES ---
    in property <string> connection_status: "Disconnected";
    in property <bool> is_connected: false;
    in property <[string]> logs: [];

    ScrollView {
        width: 100%;
        height: 100%;
        viewport-width: parent.width; // Prevent horizontal scroll

        VerticalBox {
            padding: 20px;
            spacing: 20px;
            alignment: start;

            // --- HEADER SECTION ---
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "rSMPP Client";
                    font-size: 24px;
                    font-weight: 800;
                    color: Palette.text;
                    vertical-alignment: center;
                }
                
                Rectangle { horizontal-stretch: 1; } // Spacer

                // Status Badge
                VerticalLayout {
                    alignment: center;
                        Rectangle {
                        border-radius: 12px;
                        background: root.is_connected ? Palette.success.darker(50%) : Palette.error.darker(50%);
                        border-width: 1px;
                        border-color: root.is_connected ? Palette.success : Palette.error;
                        width: 120px;
                        height: 24px;
                        
                        Text {
                            text: root.connection_status;
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 600;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // --- CONNECTION CARD ---
            Card {
                title: "Server Configuration";
                
                // HOST & PORT
                HorizontalLayout {
                    spacing: 15px;
                    host_input := LabelledInput { label: "Host IP"; value: "127.0.0.1"; horizontal-stretch: 1; }
                    port_input := LabelledInput { label: "Port"; value: "2775"; horizontal-stretch: 1; }
                }

                // USER & PASS
                HorizontalLayout {
                    spacing: 15px;
                    sys_id_input := LabelledInput { label: "System ID"; placeholder: "Username"; horizontal-stretch: 1; }
                    pass_input := LabelledInput { label: "Password"; placeholder: "********"; input-type: password; horizontal-stretch: 1; }
                }

                // BIND MODE, SSL, & BUTTON
                HorizontalLayout {
                    spacing: 15px;
                    // alignment: stretch; 
                    
                    // SSL Checkbox (Left aligned, fills space)
                    VerticalLayout {
                        alignment: center;
                        padding-top: 20px;
                        horizontal-stretch: 1;
                        ssl_check := StyledCheckBox { text: "Use TLS"; }
                    }

                    // Bind Mode
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Bind Mode"; color: Palette.text-muted; font-size: 11px; }
                        bind_mode_combo := ComboBox {
                            model: ["Transceiver", "Transmitter", "Receiver"];
                            current-value: "Transceiver";
                            height: 32px;
                        }
                    }

                    // Connect Button
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        Button {
                            text: root.is_connected ? "Disconnect" : "Connect";
                            primary: !root.is_connected;
                            height: 32px;
                            clicked => {
                                if (root.is_connected) { root.unbind(); }
                                else { root.connect(host_input.value, port_input.value, sys_id_input.value, pass_input.value, bind_mode_combo.current-value, ssl_check.checked); } 
                            }
                        }
                    }
                }
            }

            // --- MESSAGING CARD ---
            Card {
                title: "Compose Message";

                // SOURCE ROW
                HorizontalLayout {
                    spacing: 10px;
                    src_addr := LabelledInput { label: "Source Address"; placeholder: "Sender ID"; horizontal-stretch: 1; }
                    src_ton := LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    src_npi := LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                // DEST ROW
                HorizontalLayout {
                    spacing: 10px;
                    dest_addr := LabelledInput { label: "Destination Address"; placeholder: "+1234567890"; horizontal-stretch: 1; }
                    dest_ton := LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    dest_npi := LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                Rectangle { height: 1px; background: Palette.border; } // Divider

                // MESSAGE BODY
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Message Content"; color: Palette.text-muted; font-size: 11px; horizontal-stretch: 1; }
                        Text { text: root.string_length(msg_body.text) + " chars"; color: Palette.text-muted; font-size: 11px; }
                    }
                    msg_body := TextEdit { 
                        height: 80px;
                    }
                }

                // PID, DCS & MULTIPART ROW
                HorizontalLayout {
                    spacing: 10px;
                    pid_input := LabelledInput { label: "PID"; value: "0"; horizontal-stretch: 1; width: 80px; }
                    dcs_input := LabelledInput { label: "DCS"; value: "0"; horizontal-stretch: 1; width: 80px; }
                    
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Mode"; color: Palette.text-muted; font-size: 11px; }
                        multipart_combo := ComboBox {
                             model: ["UDH", "SAR", "Payload"];
                             current-value: "UDH";
                             height: 32px;
                        }
                    }
                }

                // OPTIONS ROW
                HorizontalLayout {
                    spacing: 10px;
                    
                    VerticalLayout {
                        spacing: 4px; 
                        horizontal-stretch: 1; // Reduced stretch
                        Text { text: "Encoding"; color: Palette.text-muted; font-size: 11px; }
                        encoding_combo := ComboBox { model: ["GSM 7-bit", "Latin-1", "UCS-2"]; current-value: "GSM 7-bit"; height: 32px; width: 150px; }
                    }
                    
                    validity_input := LabelledInput { label: "Validity"; placeholder: "Default"; width: 150px; } // Fixed small width

                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 1; // Don't stretch
                        dlr_check := StyledCheckBox { text: "DLR"; checked: true; }
                    }
                }

                Button {
                    text: "Send Message";
                    height: 40px;
                    primary: true;
                    clicked => {
                        root.send_message(
                            src_addr.value, src_ton.value, src_npi.value,
                            dest_addr.value, dest_ton.value, dest_npi.value,
                            msg_body.text, encoding_combo.current-value, multipart_combo.current-value,
                            pid_input.value, dcs_input.value, validity_input.value, dlr_check.checked
                        );
                    }
                }
            }

            // --- ANCILLARY OPERATIONS CARD ---
            Card {
                title: "Ancillary Operations";

                // SOURCE ROW
                HorizontalLayout {
                    spacing: 10px;
                    adv_src_addr := LabelledInput { label: "Source Address"; placeholder: "Sender ID"; horizontal-stretch: 1; }
                    adv_src_ton := LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    adv_src_npi := LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                // DEST ROW
                HorizontalLayout {
                    spacing: 10px;
                    adv_dest_addr := LabelledInput { label: "Destination Address"; placeholder: "+1234567890"; horizontal-stretch: 1; }
                    adv_dest_ton := LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    adv_dest_npi := LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                // MESSAGE ID ROW
                HorizontalLayout {
                    spacing: 10px;
                    Text { 
                        text: "Message ID:"; 
                        vertical-alignment: center; 
                        color: Palette.text-muted;
                        font-size: 11px;
                    }
                    adv_msg_id := LineEdit { 
                        placeholder-text: "Msg ID from SubmitResp"; 
                        height: 32px;
                    }
                }

                // NEW MESSAGE BODY
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "New Message Text (Replace)"; color: Palette.text-muted; font-size: 11px; }
                    adv_new_msg := TextEdit { 
                        height: 50px; // Reduced height compared to SubmitSm (80px)
                    }
                }

                // ACTION BUTTONS
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 5px;

                    Button {
                        text: "Query SM";
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.query_sm(adv_msg_id.text, adv_src_addr.value, adv_src_ton.value, adv_src_npi.value); 
                        }
                    }

                    Button {
                        text: "Cancel SM";
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.cancel_sm(
                                adv_msg_id.text,
                                adv_src_addr.value, adv_src_ton.value, adv_src_npi.value,
                                adv_dest_addr.value, adv_dest_ton.value, adv_dest_npi.value
                            );
                        }
                    }

                    Button {
                        text: "Replace SM";
                        height: 32px;
                        primary: true;
                        clicked => {
                            root.replace_sm(
                                adv_msg_id.text,
                                adv_src_addr.value, adv_src_ton.value, adv_src_npi.value,
                                adv_new_msg.text
                            );
                        }
                    }
                }
            }

            // --- TERMINAL / LOGS ---
            Card {
                title: "Transaction Logs";
                VerticalLayout {
                    Rectangle {
                        background: #000000;
                        border-radius: 4px;
                        border-color: Palette.border;
                        border-width: 1px;
                        height: 150px;
                        clip: true;

                        ScrollView {
                            viewport-y: self.viewport-height > self.height ? self.height - self.viewport-height : 0px;
                            VerticalBox {
                                alignment: start;
                                spacing: 2px;
                                padding: 8px;
                                for log in root.logs : LineEdit {
                                    text: "> " + log;
                                    read-only: true;
                                    enabled: true;
                                    height: 20px;
                                    font-size: 12px;
                                    placeholder-text: ""; 
                                    // Customizing look to mimic terminal text
                                    // Note: Slint LineEdit styling is limited in standard widget set
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}