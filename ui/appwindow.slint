import { Button, VerticalBox, LineEdit, GroupBox, HorizontalBox, ComboBox, CheckBox, ScrollView, StandardListView } from "std-widgets.slint";

// --- THEME CONFIGURATION ---
global Palette {
    out property <color> background: #121212;
    out property <color> surface: #1e1e1e;
    out property <color> border: #333333;
    out property <color> primary: #3daee9;
    out property <color> text: #e0e0e0;
    out property <color> text-muted: #888888;
    out property <color> success: #2ecc71;
    out property <color> error: #e74c3c;
}

// --- REUSABLE COMPONENT: INPUT FIELD WITH LABEL ---
component LabelledInput inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: text;
    
    spacing: 4px;

    Text {
        text: root.label;
        color: Palette.text-muted;
        font-size: 11px;
    }
    input := LineEdit {
        placeholder-text: root.placeholder;
        input-type: root.input-type;
        height: 32px;
    }
}

// --- REUSABLE COMPONENT: CARD CONTAINER ---
component Card inherits Rectangle {
    in property <string> title;
    
    background: Palette.surface;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.border;

    VerticalLayout {
        padding: 15px;
        spacing: 12px;

        if (root.title != "") : Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Palette.primary;
        }
        @children
    }
}

// --- MAIN APPLICATION ---
export component AppWindow inherits Window {
    title: "rSMPP Client";
    min-width: 450px; 
    min-height: 700px;
    background: Palette.background;

    // --- CALLBACKS ---
    callback connect(string, string, string, string, string, bool); // ip, port, system_id, password, bind_mode, use_ssl
    callback unbind(); 
    callback send_message(
        string, string, string, // source
        string, string, string, // dest
        string, string, string, string, string, string, bool // payload details
    ); 

    // --- PROPERTIES ---
    in property <string> connection_status: "Disconnected";
    in property <bool> is_connected: false;
    in property <[string]> logs: [];

    ScrollView {
        width: 100%;
        height: 100%;
        viewport-width: parent.width; // Prevent horizontal scroll

        VerticalBox {
            padding: 20px;
            spacing: 20px;
            alignment: start;

            // --- HEADER SECTION ---
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "rSMPP Client";
                    font-size: 24px;
                    font-weight: 800;
                    color: Palette.text;
                    vertical-alignment: center;
                }
                
                Rectangle { horizontal-stretch: 1; } // Spacer

                // Status Badge
                VerticalLayout {
                    alignment: center;
                        Rectangle {
                        border-radius: 12px;
                        background: root.is_connected ? Palette.success.darker(50%) : Palette.error.darker(50%);
                        border-width: 1px;
                        border-color: root.is_connected ? Palette.success : Palette.error;
                        width: 120px;
                        height: 24px;
                        
                        Text {
                            text: root.connection_status;
                            color: #ffffff;
                            font-size: 11px;
                            font-weight: 600;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }

            // --- CONNECTION CARD ---
            Card {
                title: "Server Configuration";
                
                // HOST & PORT
                HorizontalLayout {
                    spacing: 15px;
                    LabelledInput { label: "Host IP"; value: "127.0.0.1"; horizontal-stretch: 1; }
                    LabelledInput { label: "Port"; value: "2775"; horizontal-stretch: 1; }
                }

                // USER & PASS
                HorizontalLayout {
                    spacing: 15px;
                    LabelledInput { label: "System ID"; placeholder: "Username"; horizontal-stretch: 1; }
                    LabelledInput { label: "Password"; placeholder: "********"; input-type: password; horizontal-stretch: 1; }
                }

                // BIND MODE, SSL, & BUTTON
                HorizontalLayout {
                    spacing: 15px;
                    // alignment: stretch; 
                    
                    // SSL Checkbox (Left aligned, fills space)
                    VerticalLayout {
                        alignment: center;
                        padding-top: 20px;
                        horizontal-stretch: 1;
                        ssl_check := CheckBox { text: "Use TLS"; height: 32px; }
                    }

                    // Bind Mode
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        Text { text: "Bind Mode"; color: Palette.text-muted; font-size: 11px; }
                        ComboBox {
                            model: ["Transceiver", "Transmitter", "Receiver"];
                            current-value: "Transceiver";
                            height: 32px;
                        }
                    }

                    // Connect Button
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: end;
                        Button {
                            text: root.is_connected ? "Disconnect" : "Connect";
                            primary: !root.is_connected;
                            height: 32px;
                            clicked => {
                                if (root.is_connected) { root.unbind(); }
                                else { root.connect("127.0.0.1", "2775", "User", "Pass", "Transceiver", ssl_check.checked); } 
                            }
                        }
                    }
                }
            }

            // --- MESSAGING CARD ---
            Card {
                title: "Compose Message";

                // SOURCE ROW
                HorizontalLayout {
                    spacing: 10px;
                    LabelledInput { label: "Source Address"; placeholder: "Sender ID"; horizontal-stretch: 1; }
                    LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                // DEST ROW
                HorizontalLayout {
                    spacing: 10px;
                    LabelledInput { label: "Destination Address"; placeholder: "+1234567890"; horizontal-stretch: 1; }
                    LabelledInput { label: "TON"; value: "0"; width: 50px; }
                    LabelledInput { label: "NPI"; value: "0"; width: 50px; }
                }

                Rectangle { height: 1px; background: Palette.border; } // Divider

                // MESSAGE BODY
                VerticalLayout {
                    spacing: 4px;
                    Text { text: "Message Content"; color: Palette.text-muted; font-size: 11px; }
                    msg_body := LineEdit { 
                        placeholder-text: "Type SMS content here...";
                        height: 80px;
                    }
                }

                // OPTIONS ROW
                HorizontalLayout {
                    spacing: 10px;
                    
                    VerticalLayout {
                        spacing: 4px; 
                        horizontal-stretch: 1; // Reduced stretch
                        Text { text: "Encoding"; color: Palette.text-muted; font-size: 11px; }
                        ComboBox { model: ["GSM 7-bit", "Latin-1", "UCS-2"]; current-value: "GSM 7-bit"; height: 32px; width: 150px; }
                    }
                    
                    LabelledInput { label: "Validity"; placeholder: "Default"; width: 150px; } // Fixed small width

                    VerticalLayout {
                        alignment: end;
                        horizontal-stretch: 1; // Don't stretch
                        CheckBox { text: "DLR"; checked: true; height: 32px; }
                    }
                }

                Button {
                    text: "Send Message";
                    height: 40px;
                    primary: true;
                    clicked => {
                        // Call root.send_message(...) here
                    }
                }
            }

            // --- TERMINAL / LOGS ---
            Card {
                title: "Transaction Logs";
                VerticalLayout {
                    Rectangle {
                        background: #000000;
                        border-radius: 4px;
                        border-color: Palette.border;
                        border-width: 1px;
                        height: 150px;
                        clip: true;

                        ScrollView {
                            viewport-y: self.viewport-height > self.height ? self.height - self.viewport-height : 0px;
                            VerticalBox {
                                alignment: start;
                                spacing: 2px;
                                padding: 8px;
                                for log in root.logs : Text {
                                    text: "> " + log;
                                    color: #00ff00; // Terminal Green
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}